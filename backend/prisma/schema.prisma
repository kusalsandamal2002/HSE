generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HSE_OFFICER
  DEPARTMENT_HEAD
  MANAGEMENT_VIEWER
}

enum RecordStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CLOSED
  OVERDUE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ObservationType {
  NEAR_MISS
  UNSAFE_CONDITION
  UNSAFE_ACT
  POSITIVE_OBSERVATION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttachmentOwnerType {
  INCIDENT
  CORRECTIVE_ACTION
  MEDICAL_EXPENSE
  OBSERVATION
}


enum ImportWorkbookType {
  HSE_ACCIDENT_SUMMARY
  ESG_METRICS
  UNKNOWN
}

enum ImportBatchStatus {
  UPLOADED
  SCANNED
  VALIDATION_FAILED
  READY_FOR_APPROVAL
  APPROVED
  IMPORTED
  CANCELLED
  FAILED
}

enum ImportIssueSeverity {
  INFO
  WARNING
  ERROR
}

enum ImportPreviewRowStatus {
  VALID
  WARNING
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(HSE_OFFICER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdIncidents Incident[] @relation("IncidentCreatedBy")
  auditLogs        AuditLog[]
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees     Employee[]
  machines      Machine[]
  incidents     Incident[]
  observations  Observation[]
  workingHours  WorkingHours[]
}

model Shift {
  id        String   @id @default(uuid())
  name      String   @unique
  startTime String?
  endTime   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  incidents Incident[]
}

model Employee {
  id           String   @id @default(uuid())
  empNo        String   @unique
  name         String
  designation  String?
  departmentId String?
  shiftId      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  shift      Shift?      @relation(fields: [shiftId], references: [id])
  incidents  Incident[]
}

model Machine {
  id           String   @id @default(uuid())
  code         String?  @unique
  name         String
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  incidents  Incident[]
}

model IncidentType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
}

model InjuryType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
}

model RootCause {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents Incident[]
}

model Incident {
  id                  String           @id @default(uuid())
  incidentNo          String           @unique
  incidentDate        DateTime
  incidentTime        String?
  departmentId        String?
  shiftId             String?
  employeeId          String?
  machineId           String?
  incidentTypeId      String?
  injuryTypeId        String?
  rootCauseId         String?
  description         String
  immediateAction     String?
  correctiveAction    String?
  investigationSummary String?
  lostMinutes         Int              @default(0)
  medicalExpenseTotal Decimal          @default(0) @db.Decimal(12, 2)
  severity            IncidentSeverity @default(LOW)
  status              RecordStatus     @default(PENDING)
  isDeleted           Boolean          @default(false)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  department   Department?  @relation(fields: [departmentId], references: [id])
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  machine      Machine?     @relation(fields: [machineId], references: [id])
  incidentType IncidentType? @relation(fields: [incidentTypeId], references: [id])
  injuryType   InjuryType?   @relation(fields: [injuryTypeId], references: [id])
  rootCause    RootCause?    @relation(fields: [rootCauseId], references: [id])
  createdBy    User?         @relation("IncidentCreatedBy", fields: [createdById], references: [id])

  correctiveActions CorrectiveAction[]
  medicalExpenses   MedicalExpense[]
}

model CorrectiveAction {
  id                String       @id @default(uuid())
  actionNo          String       @unique
  incidentId        String?
  observationId     String?
  action            String
  responsiblePerson String?
  dueDate           DateTime?
  completedDate     DateTime?
  status            RecordStatus @default(PENDING)
  remarks           String?
  isDeleted         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  incident    Incident?    @relation(fields: [incidentId], references: [id])
  observation Observation? @relation(fields: [observationId], references: [id])
}

model MedicalExpense {
  id          String   @id @default(uuid())
  expenseNo   String   @unique
  incidentId  String?
  expenseDate DateTime
  amount      Decimal  @db.Decimal(12, 2)
  expenseType String?
  provider    String?
  billNo      String?
  remarks     String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incident Incident? @relation(fields: [incidentId], references: [id])
}

model Observation {
  id            String          @id @default(uuid())
  observationNo String          @unique
  observationDate DateTime
  observationTime String?
  departmentId  String?
  type          ObservationType
  riskLevel     RiskLevel       @default(LOW)
  description   String
  actionTaken   String?
  reportedBy    String?
  status        RecordStatus    @default(PENDING)
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  correctiveActions CorrectiveAction[]
}

model WorkingHours {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  departmentId   String?
  totalEmployees Int      @default(0)
  regularHours   Decimal  @default(0) @db.Decimal(12, 2)
  overtimeHours  Decimal  @default(0) @db.Decimal(12, 2)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([year, month, departmentId])
}

model TvDashboardSettings {
  id                   String   @id @default(uuid())
  companyName          String   @default("HSE Company")
  dashboardTitle       String   @default("Live HSE Dashboard")
  intervalSeconds      Int      @default(12)
  languageMode         String   @default("EN")
  displayMode          String   @default("AUTO")
  showClock            Boolean  @default(true)
  showCounter          Boolean  @default(true)
  autoAdvance          Boolean  @default(true)
  selectedYear         Int?
  selectedMonth        Int?
  selectedDepartmentId String?
  updatedAt            DateTime @updatedAt
}

model TfTsMetric {
  id          String   @id @default(uuid())
  year        Int      @unique
  tfTotal     Int      @default(0)
  tfRate      Float    @default(0)
  tsTotal     Int      @default(0)
  tsRate      Float    @default(0)
  source      String?
  periodLabel String?
  tracked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportBatch {
  id            String             @id @default(uuid())
  fileName      String
  originalName  String
  fileHash      String
  workbookType  ImportWorkbookType  @default(UNKNOWN)
  status        ImportBatchStatus   @default(UPLOADED)
  uploadedBy    String?
  uploadedAt    DateTime           @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  importedAt    DateTime?
  rowCount      Int                @default(0)
  validRowCount Int                @default(0)
  warningCount  Int                @default(0)
  errorCount    Int                @default(0)
  summaryJson   Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  file             ImportFile?
  detectedSections ImportDetectedSection[]
  previewRows      ImportPreviewRow[]
  validationIssues ImportValidationIssue[]

  @@index([fileHash])
  @@index([workbookType, status])
  @@index([uploadedAt])
}

model ImportFile {
  id           String   @id @default(uuid())
  batchId      String   @unique
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  path         String
  sha256       String
  createdAt    DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([sha256])
}

model ImportDetectedSection {
  id           String   @id @default(uuid())
  batchId      String
  sectionKey   String
  sectionLabel String
  sheetName    String?
  confidence   Float    @default(0)
  rowCount     Int      @default(0)
  summary      String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, sectionKey])
}

model ImportPreviewRow {
  id             String                 @id @default(uuid())
  batchId        String
  sectionKey     String
  rowIndex       Int
  rawJson        Json
  mappedJson     Json
  status         ImportPreviewRowStatus @default(VALID)
  validationJson  Json?
  createdAt      DateTime               @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, sectionKey, rowIndex])
}

model ImportValidationIssue {
  id          String             @id @default(uuid())
  batchId     String
  sectionKey  String?
  severity    ImportIssueSeverity
  code        String
  message     String
  detailsJson Json?
  createdAt   DateTime           @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
}

model EsgDashboardSnapshot {
  id          String   @id @default(uuid())
  year        Int      @unique
  sourceFile  String
  sourcePath  String?
  sourceSheet String?
  periodLabel String
  tracked     Boolean  @default(false)
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attachment {
  id          String              @id @default(uuid())
  ownerType   AttachmentOwnerType
  ownerId     String
  originalName String
  storedName  String
  mimeType    String
  sizeBytes   Int
  path        String
  uploadedAt  DateTime            @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

